{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personafoil.invalid/personabridge-v1.schema.json",
  "title": "PersonaBridge protocol v1 shared definitions",
  "type": "object",
  "$defs": {
    "titleId": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{16}$"
    },
    "contentType": {
      "enum": ["base", "update", "dlc", "multi"]
    },
    "sourceHealth": {
      "enum": ["unknown", "online", "degraded", "offline", "auth_required"]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "kind", "health"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"type": "string", "minLength": 1, "maxLength": 256},
        "health": {"$ref": "#/$defs/sourceHealth"},
        "priority": {"type": "integer", "minimum": -100000, "maximum": 100000}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title_id", "content_type", "version", "size", "source_id", "download_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "title_id": {"$ref": "#/$defs/titleId"},
        "content_type": {"$ref": "#/$defs/contentType"},
        "version": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0},
        "display_name": {"type": "string", "maxLength": 256},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "download_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"type": "string", "pattern": "^$|^[0-9A-Fa-f]{64}$"},
        "region": {"type": "string", "maxLength": 32},
        "languages": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "minLength": 1, "maxLength": 32}
        }
      }
    },
    "installed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_id", "content_type", "version"],
      "properties": {
        "title_id": {"$ref": "#/$defs/titleId"},
        "content_type": {"$ref": "#/$defs/contentType"},
        "version": {"type": "integer", "minimum": 0}
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": true,
      "required": ["release_id", "source_id", "download_id", "version", "size"],
      "properties": {
        "release_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "download_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title_id", "content_type", "installed_version", "latest_version", "reason", "alternatives"],
      "properties": {
        "title_id": {"$ref": "#/$defs/titleId"},
        "content_type": {"$ref": "#/$defs/contentType"},
        "installed_version": {"type": "integer", "minimum": 0},
        "latest_version": {"type": "integer", "minimum": 0},
        "reason": {"enum": ["update", "missing"]},
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/alternative"}
        }
      }
    }
  }
}
